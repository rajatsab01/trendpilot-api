{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist/server",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "resolveJsonModule": true
  },

  "include": [
    "server/**/*",
    "shared/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "client"
  ]
}
