{
  "sourcePriority": ["correctedSymbol", "symbol"],
  "transforms": [
    {
      "type": "uppercase"
    },
    {
      "type": "trim"
    }
  ],
  "overrides": [
    {
      "type": "exact",
      "pattern": "TATAMOTORS.NS",
      "replacement": "NSE:TMCV",
      "comment": "Yahoo delisted TATAMOTORS.NS; TradingView NSE ticker is TMCV"
    },
    {
      "pattern": "\\.NS$",
      "type": "regex",
      "action": "extractBase",
      "comment": "Indian NSE stocks - remove .NS suffix"
    },
    {
      "pattern": "\\.BO$",
      "type": "regex",
      "action": "extractBase",
      "comment": "Indian BSE stocks - remove .BO suffix"
    },
    {
      "pattern": "\\.L$",
      "type": "regex",
      "action": "extractBase",
      "comment": "London stocks - remove .L suffix"
    },
    {
      "pattern": "\\.T$",
      "type": "regex",
      "action": "extractBase",
      "comment": "Tokyo stocks - remove .T suffix"
    },
    {
      "pattern": "\\.HK$",
      "type": "regex",
      "action": "extractBase",
      "comment": "Hong Kong stocks - remove .HK suffix"
    },
    {
      "pattern": "\\.AX$",
      "type": "regex",
      "action": "extractBase",
      "comment": "Australian stocks - remove .AX suffix"
    },
    {
      "pattern": "\\.TO$",
      "type": "regex",
      "action": "extractBase",
      "comment": "Toronto stocks - remove .TO suffix"
    },
    {
      "pattern": "\\.DE$",
      "type": "regex",
      "action": "extractBase",
      "comment": "German stocks - remove .DE suffix"
    },
    {
      "pattern": "\\.PA$",
      "type": "regex",
      "action": "extractBase",
      "comment": "Paris stocks - remove .PA suffix"
    }
  ],
  "fallback": {
    "useAsIs": true,
    "comment": "Use ticker as-is for other markets (e.g., US stocks)"
  }
}
