{
  "sourcePriority": ["correctedSymbol", "symbol", "assetName", "instrumentName"],
  "transforms": [
    {
      "type": "uppercase"
    },
    {
      "type": "trim"
    }
  ],
  "overrides": [
    {
      "pattern": "\\.NS$",
      "type": "regex",
      "action": "extractBase",
      "prefix": "NSE:",
      "comment": "Indian NSE stocks"
    },
    {
      "pattern": "\\.BO$",
      "type": "regex",
      "action": "extractBase",
      "prefix": "BSE:",
      "comment": "Indian BSE stocks"
    },
    {
      "pattern": "\\.L$",
      "type": "regex",
      "action": "extractBase",
      "prefix": "LSE:",
      "comment": "London stocks"
    },
    {
      "pattern": "\\.T$",
      "type": "regex",
      "action": "extractBase",
      "prefix": "TSE:",
      "comment": "Tokyo stocks"
    },
    {
      "pattern": "\\.HK$",
      "type": "regex",
      "action": "extractBase",
      "prefix": "HKEX:",
      "comment": "Hong Kong stocks"
    },
    {
      "pattern": "\\.AX$",
      "type": "regex",
      "action": "extractBase",
      "prefix": "ASX:",
      "comment": "Australian stocks"
    },
    {
      "pattern": "\\.TO$",
      "type": "regex",
      "action": "extractBase",
      "prefix": "TSX:",
      "comment": "Toronto stocks"
    }
  ],
  "fallback": {
    "useAsIs": true,
    "comment": "US stocks - TradingView auto-detects NYSE/NASDAQ"
  }
}
